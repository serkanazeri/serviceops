{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serviceops", "main": "worker/index.ts", "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "ENVIRONMENT": "development", "MODEL_MODE": "fixture", "OPENROUTER_MODEL": "openai/gpt-6-luna", "DAILY_BUDGET_USD": "1", "MONTHLY_BUDGET_USD": "10", "EVAL_BUDGET_USD": "5" },
  "d1_databases": [{ "binding": "DB", "database_name": "serviceops", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "workflows": [{ "name": "serviceops-cases", "binding": "CASES", "class_name": "CaseWorkflow" }],
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "BudgetGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetGuard"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["17 * * * *"] }
}
