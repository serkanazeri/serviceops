{
  "name": "serviceops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Türkçe, ölçülebilir ve insan onaylı servis operasyonları agentı.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "wrangler dev --port 8788",
    "dev:web": "vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply serviceops --local",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "test": "vitest run",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run evaluate && npm run build",
    "preview": "wrangler dev --port 8788",
    "deploy": "npm run check && wrangler deploy --config wrangler.production.json",
    "evaluate:live": "node --import tsx scripts/evaluate-live.ts",
    "format": "prettier --write src worker shared tests e2e scripts docs *.md *.ts *.json",
    "format:check": "prettier --check src worker shared tests e2e scripts docs *.md *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
